      "@grpc/grpc-js": "1.14.7"
    },
    "firebase-tools": {
      "glob": {
        ".": "14.0.2",
        "minimatch": "11.0.1"
      },
      "gaxios@6": {
        "uuid": "11.1.1"
      },
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "2.8.0"
      }
    }
