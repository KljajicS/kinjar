rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function familyPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function statePath(fid, did) { return /databases/$(database)/documents/families/$(fid)/datasets/$(did); }
    function opPath(fid, did, oid) { return /databases/$(database)/documents/families/$(fid)/datasets/$(did)/operations/$(oid); }
    function member(fid) {
      return signedIn() && request.auth.uid in get(familyPath(fid)).data.members
        && get(familyPath(fid)).data.status != 'DELETING';
    }
    function admin(fid) { return member(fid) && request.auth.uid in get(familyPath(fid)).data.admins; }
    function deletingOwner(fid) {
      return signedIn() && get(familyPath(fid)).data.owner == request.auth.uid && get(familyPath(fid)).data.status == 'DELETING';
    }
    function invitedAt(fid, sid) {
      let path = /databases/$(database)/documents/families/$(fid)/invites/$(sid);
      return signedIn() && exists(path) && get(path).data.status == 'PENDING'
        && get(path).data.email == request.auth.token.email && get(path).data.createdAt + duration.value(6, 'd') > request.time;
    }
    function invited(fid) {
      return invitedAt(fid, '0') || invitedAt(fid, '1') || invitedAt(fid, '2')
        || invitedAt(fid, '3') || invitedAt(fid, '4') || invitedAt(fid, '5');
    }
    function identifier(id) { return id is string && id.matches('[A-Za-z0-9_-]{1,128}'); }
    function slot(id) { return id.matches('[0-9]'); }
    function smallSlot(id) { return id.matches('[0-5]'); }
    function familyShape(d) {
      return d.keys().hasOnly(['owner', 'admins', 'members', 'slot', 'activeDataset', 'otherDataset', 'generation', 'status', 'action', 'target', 'inviteSlot', 'restoreToken', 'restoreUid', 'restoreStartedAt', 'deletionPhase'])
        && identifier(d.owner) && d.admins is list && d.admins.size() >= 1 && d.admins.size() <= 6
        && d.admins.toSet().size() == d.admins.size() && d.owner in d.admins
        && d.members is map && d.members.size() >= 1 && d.members.size() <= 6
        && d.members.keys().hasAll(d.admins) && slot(d.slot)
        && identifier(d.activeDataset) && (d.otherDataset == '' || identifier(d.otherDataset))
        && d.generation is int && d.generation >= 1 && d.generation <= 2147483647
        && d.status in ['INITIALIZING', 'ACTIVE', 'RESTORING', 'DELETING', 'ARCHIVED']
        && d.action is string && d.action.size() <= 16 && d.target is string && d.target.size() <= 128
        && d.inviteSlot is string && d.inviteSlot.size() <= 1
        && (!('restoreToken' in d) || identifier(d.restoreToken))
        && (!('restoreUid' in d) || identifier(d.restoreUid))
        && (!('restoreStartedAt' in d) || d.restoreStartedAt is timestamp)
        && (!('deletionPhase' in d) || (d.deletionPhase is int && d.deletionPhase >= 0 && d.deletionPhase <= 2))
        && (d.status != 'RESTORING' || (identifier(d.restoreToken) && identifier(d.restoreUid) && d.restoreStartedAt is timestamp));
    }
    function linkedAfter(uid, fid) {
      return getAfter(userPath(uid)).data.familyId == fid && getAfter(userPath(uid)).data.status == 'ACTIVE'
        && getAfter(userPath(uid)).data.memberId == getAfter(familyPath(fid)).data.members[uid];
    }
    function noFamily(uid) {
      return !exists(userPath(uid)) || get(userPath(uid)).data.status == 'REMOVED';
    }
    function open(fid) { return get(familyPath(fid)).data.status != 'ARCHIVED'; }
    // A personal workspace is archived, never deleted, in the same commit that moves its owner to target.
    function archivedBy(uid, source, target) {
      let before = get(familyPath(source)).data;
      let after = getAfter(familyPath(source)).data;
      return source != target && before.status == 'ACTIVE' && after.status == 'ARCHIVED'
        && after.action == 'archive' && after.target == target && after.owner == uid;
    }
    function switchingFrom(uid, target) {
      let user = get(userPath(uid)).data;
      return user.status == 'ACTIVE' && archivedBy(uid, user.familyId, target);
    }

    match /slots/{id} {
      allow get: if signedIn();
      allow create: if signedIn() && slot(id) && request.resource.data.keys().hasOnly(['familyId', 'owner'])
        && identifier(request.resource.data.familyId) && request.resource.data.owner == request.auth.uid
        && !exists(familyPath(request.resource.data.familyId))
        && getAfter(familyPath(request.resource.data.familyId)).data.slot == id
        && getAfter(familyPath(request.resource.data.familyId)).data.owner == request.auth.uid;
      allow delete: if deletingOwner(resource.data.familyId) && resource.data.owner == request.auth.uid
        && !existsAfter(familyPath(resource.data.familyId));
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner'])
        && get(familyPath(resource.data.familyId)).data.owner == request.auth.uid
        && getAfter(familyPath(resource.data.familyId)).data.owner == request.resource.data.owner;
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['familyId', 'memberId', 'status'])
        && identifier(request.resource.data.familyId) && identifier(request.resource.data.memberId)
        && ((request.auth.uid == uid && noFamily(uid)
          && request.resource.data.status == 'ACTIVE'
          && getAfter(familyPath(request.resource.data.familyId)).data.members[uid] == request.resource.data.memberId)
          || (resource.data.status == 'ACTIVE' && request.resource.data.status == 'REMOVED'
            && request.resource.data.familyId == resource.data.familyId
            && request.resource.data.memberId == resource.data.memberId
            && admin(resource.data.familyId)
            && (!(uid in getAfter(familyPath(resource.data.familyId)).data.members)
              || getAfter(familyPath(resource.data.familyId)).data.status == 'DELETING'))
          || (request.auth.uid == uid && resource.data.status == 'ACTIVE' && request.resource.data.status == 'ACTIVE'
            && archivedBy(uid, resource.data.familyId, request.resource.data.familyId)
            && getAfter(familyPath(request.resource.data.familyId)).data.members[uid] == request.resource.data.memberId));
    }

    match /families/{fid} {
      allow get: if member(fid) || deletingOwner(fid) || invited(fid);
      allow list: if signedIn() && resource.data.owner == request.auth.uid && resource.data.status == 'ARCHIVED';
      allow create: if signedIn() && identifier(fid) && familyShape(request.resource.data) && noFamily(request.auth.uid)
        && request.resource.data.owner == request.auth.uid && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && identifier(request.resource.data.members[request.auth.uid])
        && request.resource.data.status == 'INITIALIZING' && request.resource.data.generation == 1
        && request.resource.data.otherDataset == '' && request.resource.data.action == 'create'
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slot)).data.familyId == fid
        && getAfter(/databases/$(database)/documents/slots/$(request.resource.data.slot)).data.owner == request.auth.uid
        && linkedAfter(request.auth.uid, fid);

      function joining() {
        let invite = get(/databases/$(database)/documents/families/$(fid)/invites/$(request.resource.data.inviteSlot)).data;
        let after = getAfter(/databases/$(database)/documents/families/$(fid)/invites/$(request.resource.data.inviteSlot)).data;
        return signedIn() && resource.data.status == 'ACTIVE'
          && (noFamily(request.auth.uid) || switchingFrom(request.auth.uid, fid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'action', 'target', 'inviteSlot'])
          && request.resource.data.action == 'join' && request.resource.data.target == request.auth.uid
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.members) && identifier(request.resource.data.members[request.auth.uid])
          && invite.status == 'PENDING' && invite.email == request.auth.token.email && invite.createdAt + duration.value(6, 'd') > request.time
          && after.status == 'ACCEPTED' && after.uid == request.auth.uid && linkedAfter(request.auth.uid, fid);
      }
      function archiving() {
        let user = getAfter(userPath(request.auth.uid)).data;
        let target = getAfter(familyPath(user.familyId)).data;
        return resource.data.status == 'ACTIVE' && resource.data.owner == request.auth.uid
          && resource.data.admins == [request.auth.uid] && resource.data.members.keys().hasOnly([request.auth.uid])
          && request.resource.data.status == 'ARCHIVED' && request.resource.data.inviteSlot == ''
          && request.resource.data.target == user.familyId && user.familyId != fid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'target', 'inviteSlot'])
          && get(userPath(request.auth.uid)).data.familyId == fid && get(userPath(request.auth.uid)).data.status == 'ACTIVE'
          && linkedAfter(request.auth.uid, user.familyId) && target.action == 'join' && target.target == request.auth.uid;
      }
      function removing() {
        let target = request.resource.data.target;
        return admin(fid) && target in resource.data.members && target != resource.data.owner
          && (!(target in resource.data.admins) || request.auth.uid == resource.data.owner)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'action', 'target'])
          && request.resource.data.action == 'remove'
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([target])
          && !(target in request.resource.data.members)
          && request.resource.data.admins.toSet() == resource.data.admins.toSet().difference([target].toSet())
          && getAfter(userPath(target)).data.status == 'REMOVED'
          && getAfter(userPath(target)).data.familyId == fid;
      }
      function roles() {
        return request.auth.uid == resource.data.owner && resource.data.status == 'ACTIVE'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'admins', 'action'])
          && request.resource.data.action in ['roles', 'transfer']
          && (request.resource.data.owner == resource.data.owner || (request.resource.data.action == 'transfer'
            && getAfter(/databases/$(database)/documents/slots/$(resource.data.slot)).data.owner == request.resource.data.owner));
      }
      function activateInitial() {
        let state = getAfter(statePath(fid, resource.data.activeDataset)).data;
        return request.auth.uid == resource.data.owner && resource.data.status == 'INITIALIZING'
          && request.resource.data.status == 'ACTIVE' && request.resource.data.action == 'activate'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'action'])
          && state.sealed == true && state.chunks == state.expectedChunks && state.chunkBytes == state.expectedBytes;
      }
      function beginRestore() {
        let after = request.resource.data;
        return admin(fid) && resource.data.status == 'ACTIVE' && resource.data.otherDataset == ''
          && after.status == 'RESTORING' && after.action == 'restore'
          && after.generation == resource.data.generation + 1 && identifier(after.otherDataset)
          && after.otherDataset != resource.data.activeDataset && !exists(statePath(fid, after.otherDataset))
          && after.restoreUid == request.auth.uid && after.restoreStartedAt == request.time
          && after.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'generation', 'otherDataset', 'restoreToken', 'restoreUid', 'restoreStartedAt']);
      }
      function finishRestore() {
        let after = request.resource.data;
        let state = getAfter(statePath(fid, resource.data.otherDataset)).data;
        return admin(fid) && resource.data.status == 'RESTORING' && resource.data.restoreUid == request.auth.uid
          && resource.data.restoreStartedAt + duration.value(25, 'm') > request.time && after.status == 'ACTIVE' && after.action == 'restored'
          && after.activeDataset == resource.data.otherDataset && after.otherDataset == resource.data.activeDataset
          && state.restoreToken == resource.data.restoreToken && state.sealed == true
          && state.chunks == state.expectedChunks && state.chunkBytes == state.expectedBytes
          && after.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'activeDataset', 'otherDataset', 'restoreToken', 'restoreUid', 'restoreStartedAt']);
      }
      function cancelRestore() {
        return admin(fid) && resource.data.status == 'RESTORING'
          && (resource.data.restoreUid == request.auth.uid || resource.data.restoreStartedAt + duration.value(25, 'm') <= request.time)
          && request.resource.data.status == 'ACTIVE' && request.resource.data.action == 'cancelRestore'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'restoreToken', 'restoreUid', 'restoreStartedAt']);
      }
      function cleaned() {
        return admin(fid) && resource.data.status == 'ACTIVE' && resource.data.otherDataset != ''
          && request.resource.data.otherDataset == '' && !existsAfter(statePath(fid, resource.data.otherDataset))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['otherDataset', 'action'])
          && request.resource.data.action == 'cleaned';
      }
      function removedAfter(uid) {
        return getAfter(userPath(uid)).data.status == 'REMOVED' && getAfter(userPath(uid)).data.familyId == fid;
      }
      function beginDelete() {
        let users = resource.data.members.keys();
        return request.auth.uid == resource.data.owner && resource.data.status != 'DELETING'
          && request.resource.data.status == 'DELETING' && request.resource.data.deletionPhase == 0 && request.resource.data.action == 'delete'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'action', 'deletionPhase'])
          && removedAfter(users[0]) && (users.size() < 2 || removedAfter(users[1]))
          && (users.size() < 3 || removedAfter(users[2])) && (users.size() < 4 || removedAfter(users[3]))
          && (users.size() < 5 || removedAfter(users[4])) && (users.size() < 6 || removedAfter(users[5]));
      }
      function absent(collection, slot) {
        return !existsAfter(/databases/$(database)/documents/families/$(fid)/$(collection)/$(slot));
      }
      function clearedSlots(collection) {
        return absent(collection, '0') && absent(collection, '1') && absent(collection, '2')
          && absent(collection, '3') && absent(collection, '4') && absent(collection, '5');
      }
      function deletionProgress() {
        return deletingOwner(fid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionPhase', 'action'])
          && ((resource.data.deletionPhase == 0 && request.resource.data.deletionPhase == 1 && clearedSlots('invites'))
            || (resource.data.deletionPhase == 1 && request.resource.data.deletionPhase == 2 && clearedSlots('installs')));
      }
      allow update: if signedIn() && familyShape(request.resource.data) && resource.data.status != 'ARCHIVED'
        && ((request.resource.data.action == 'join' && joining())
          || (request.resource.data.action == 'archive' && archiving())
          || (request.resource.data.action == 'remove' && removing())
          || (request.resource.data.action in ['roles', 'transfer'] && roles())
          || (request.resource.data.action == 'activate' && activateInitial())
          || (request.resource.data.action == 'restore' && beginRestore())
          || (request.resource.data.action == 'restored' && finishRestore())
          || (request.resource.data.action == 'cancelRestore' && cancelRestore())
          || (request.resource.data.action == 'cleaned' && cleaned())
          || (request.resource.data.action == 'delete' && beginDelete())
          || (request.resource.data.action == 'deleteSlots' && deletionProgress()));
      allow delete: if deletingOwner(fid) && resource.data.deletionPhase == 2
        && !exists(statePath(fid, resource.data.activeDataset))
        && (resource.data.otherDataset == '' || !exists(statePath(fid, resource.data.otherDataset)))
        && !existsAfter(/databases/$(database)/documents/slots/$(resource.data.slot));

      match /invites/{sid} {
        allow get, list: if signedIn() && (resource.data.email == request.auth.token.email || admin(fid) || deletingOwner(fid));
        function shape(d) {
          return smallSlot(sid) && d.keys().hasOnly(['familyId', 'email', 'inviter', 'inviterEmail', 'createdAt', 'status', 'uid'])
            && d.familyId == fid && d.email is string && d.email.size() >= 3 && d.email.size() <= 254
            && identifier(d.inviter) && d.inviterEmail is string && d.inviterEmail.size() <= 254
            && d.createdAt is timestamp && d.uid is string && d.uid.size() <= 128;
        }
        allow create: if admin(fid) && open(fid) && shape(request.resource.data) && request.resource.data.inviter == request.auth.uid
          && request.resource.data.inviterEmail == request.auth.token.email
          && request.resource.data.status == 'PENDING' && request.resource.data.uid == ''
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && shape(request.resource.data) && open(fid)
          && ((admin(fid) && request.resource.data.status == 'CANCELLED'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (resource.data.status == 'PENDING' && resource.data.email == request.auth.token.email
              && resource.data.createdAt + duration.value(6, 'd') > request.time && request.resource.data.status == 'ACCEPTED'
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid'])
              && linkedAfter(request.auth.uid, fid)));
        allow delete: if deletingOwner(fid) || (admin(fid) && open(fid) && resource.data.status != 'PENDING');
      }

      match /installs/{sid} {
        allow get, list: if member(fid) || deletingOwner(fid);
        allow create: if member(fid) && open(fid) && smallSlot(sid)
          && request.resource.data.keys().hasOnly(['uid', 'installId', 'name', 'createdAt'])
          && request.resource.data.uid == request.auth.uid && identifier(request.resource.data.installId)
          && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.createdAt == request.time;
        allow delete: if deletingOwner(fid) || (open(fid) && (admin(fid) || (member(fid) && resource.data.uid == request.auth.uid)));
      }

      match /datasets/{did} {
        allow get: if member(fid) || deletingOwner(fid);
        function stateShape(d) {
          return d.keys().hasOnly(['count', 'bytes', 'day', 'dailyCount', 'dailyBytes', 'lastOpId', 'chunks', 'chunkBytes', 'expectedChunks', 'expectedBytes', 'digest', 'lastChunk', 'sealed', 'restoreToken', 'historyVersion'])
            && d.count is int && d.count >= 0
            && d.bytes is int && d.bytes >= 0
            && d.day is timestamp && d.dailyCount is int && d.dailyCount >= 0 && d.dailyCount <= 200
            && d.get('dailyBytes', 0) is int && d.get('dailyBytes', 0) >= 0 && d.get('dailyBytes', 0) <= 8388608
            && d.lastOpId is string && d.lastOpId.size() <= 160;
        }
        function day(value) { return int(value.toMillis() / 86400000); }
        function writable() {
          let f = get(familyPath(fid)).data;
          return member(fid) && f.status == 'ACTIVE' && f.activeDataset == did;
        }
        // Count and byte budgets reset together; datasets written before dailyBytes existed start from zero.
        function increment(before, after, oid, op) {
          let sameDay = day(before.day) == day(request.time);
          return stateShape(after) && after.count == before.count + 1 && after.bytes == before.bytes + op.payload.size()
            && after.day == request.time && after.dailyCount == (sameDay ? before.dailyCount + 1 : 1)
            && after.dailyBytes == (sameDay ? before.get('dailyBytes', 0) + op.cost : op.cost)
            && after.lastOpId == oid
            && after.diff(before).affectedKeys().hasOnly(['count', 'bytes', 'day', 'dailyCount', 'dailyBytes', 'lastOpId']);
        }
        function manifest(d) {
          return (d.get('historyVersion', 1) == 2 ||
              (d.get('historyVersion', 1) == 1 && d.expectedChunks <= 128 && d.expectedBytes <= 67108864))
            && d.expectedBytes is int && d.expectedBytes > 0 && d.expectedBytes <= 9007199254740991
            && d.expectedChunks is int && d.expectedChunks >= 1 && d.expectedChunks <= d.expectedBytes
            && int((d.expectedBytes - 1) / 524288) < d.expectedChunks
            && d.digest is string && d.digest.matches('[0-9a-f]{64}')
            && d.chunks is int && d.chunks >= 0 && d.chunks <= d.expectedChunks
            && d.chunkBytes is int && d.chunkBytes >= 0 && d.chunkBytes <= d.expectedBytes
            && d.lastChunk is string && d.lastChunk.size() <= 16 && d.sealed is bool;
        }
        function initializing() {
          let f = get(familyPath(fid)).data;
          return signedIn() && ((request.auth.uid == f.owner && f.status == 'INITIALIZING' && f.activeDataset == did)
            || (admin(fid) && f.status == 'RESTORING' && f.otherDataset == did
              && f.restoreUid == request.auth.uid && f.restoreStartedAt + duration.value(25, 'm') > request.time));
        }
        function retired() {
          let f = get(familyPath(fid)).data;
          return deletingOwner(fid) || (admin(fid) && f.status == 'ACTIVE' && f.otherDataset == did && f.activeDataset != did);
        }
        function chunkIncrement(before, after, cid, payload) {
          return manifest(after) && stateShape(after) && before.sealed == false && after.sealed == false
            && after.chunks == before.chunks + 1 && after.chunkBytes == before.chunkBytes + payload.size()
            && after.lastChunk == cid
            && after.diff(before).affectedKeys().hasOnly(['chunks', 'chunkBytes', 'lastChunk']);
        }
        function sealing() {
          return resource.data.sealed == false && request.resource.data.sealed == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sealed'])
            && resource.data.chunks == resource.data.expectedChunks && resource.data.chunkBytes == resource.data.expectedBytes
            && getAfter(familyPath(fid)).data.status == 'ACTIVE'
            && getAfter(familyPath(fid)).data.activeDataset == did;
        }
        allow create: if initializing() && stateShape(request.resource.data)
          && request.resource.data.historyVersion == 2
          && request.resource.data.get('restoreToken', '') == get(familyPath(fid)).data.get('restoreToken', '')
          && request.resource.data.count == 0 && request.resource.data.bytes == 0
          && request.resource.data.dailyCount == 0 && request.resource.data.dailyBytes == 0 && request.resource.data.day == request.time
          && request.resource.data.lastOpId == '' && manifest(request.resource.data)
          && request.resource.data.chunks == 0 && request.resource.data.chunkBytes == 0 && request.resource.data.sealed == false;
        allow update: if writable() && stateShape(request.resource.data)
          && !exists(opPath(fid, did, request.resource.data.lastOpId))
          && increment(resource.data, request.resource.data, request.resource.data.lastOpId,
            getAfter(opPath(fid, did, request.resource.data.lastOpId)).data)
          || (initializing() && (sealing() ||
            (!exists(/databases/$(database)/documents/families/$(fid)/datasets/$(did)/chunks/$(request.resource.data.lastChunk))
              && chunkIncrement(resource.data, request.resource.data, request.resource.data.lastChunk,
                getAfter(/databases/$(database)/documents/families/$(fid)/datasets/$(did)/chunks/$(request.resource.data.lastChunk)).data.payload))))
          || (retired() && (removingOperation() || removingChunk()));

        function decrement(before, after, payload) {
          return stateShape(after) && after.count == before.count - 1 && after.bytes == before.bytes - payload.size()
            && after.diff(before).affectedKeys().hasOnly(['count', 'bytes', 'lastOpId']);
        }
        function decrementChunk(before, after, payload) {
          return stateShape(after) && after.chunks == before.chunks - 1 && after.chunkBytes == before.chunkBytes - payload.size()
            && after.chunks >= 0 && after.chunkBytes >= 0
            && after.diff(before).affectedKeys().hasOnly(['chunks', 'chunkBytes', 'lastChunk']);
        }
        function removingOperation() {
          let path = opPath(fid, did, request.resource.data.lastOpId);
          return exists(path) && !existsAfter(path) && decrement(resource.data, request.resource.data, get(path).data.payload);
        }
        function removingChunk() {
          let path = /databases/$(database)/documents/families/$(fid)/datasets/$(did)/chunks/$(request.resource.data.lastChunk);
          return exists(path) && !existsAfter(path) && decrementChunk(resource.data, request.resource.data, get(path).data.payload);
        }
        allow delete: if retired() && resource.data.count == 0 && resource.data.bytes == 0
          && resource.data.chunks == 0 && resource.data.chunkBytes == 0
          && (deletingOwner(fid) || getAfter(familyPath(fid)).data.otherDataset == '');

        match /chunks/{cid} {
          allow get, list: if deletingOwner(fid) || (member(fid) && (get(familyPath(fid)).data.activeDataset == did || admin(fid)));
          allow create: if initializing() && cid.matches('[0-9]{1,16}') && string(int(cid)) == cid
            && request.resource.data.keys().hasOnly(['payload']) && request.resource.data.payload is bytes
            && request.resource.data.payload.size() > 0 && request.resource.data.payload.size() <= 524288
            && int(cid) < get(statePath(fid, did)).data.expectedChunks
            && chunkIncrement(get(statePath(fid, did)).data, getAfter(statePath(fid, did)).data, cid, request.resource.data.payload);
          allow delete: if retired() && getAfter(statePath(fid, did)).data.lastChunk == cid
            && decrementChunk(get(statePath(fid, did)).data, getAfter(statePath(fid, did)).data, resource.data.payload);
        }

        match /operations/{oid} {
          allow get, list: if deletingOwner(fid) || (member(fid) && (get(familyPath(fid)).data.activeDataset == did || admin(fid)));
          allow create: if writable()
            && request.resource.data.keys().hasOnly(['uid', 'installId', 'installSlot', 'sequence', 'payload', 'cost', 'createdAt'])
            && request.resource.data.uid == request.auth.uid && identifier(request.resource.data.installId)
            && request.resource.data.sequence is int && request.resource.data.sequence > 0
            && request.resource.data.sequence <= 2147483647
            && smallSlot(request.resource.data.installSlot)
            && get(/databases/$(database)/documents/families/$(fid)/installs/$(request.resource.data.installSlot)).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/families/$(fid)/installs/$(request.resource.data.installSlot)).data.installId == request.resource.data.installId
            && oid == request.resource.data.installId + ':' + string(request.resource.data.sequence)
            && request.resource.data.payload is bytes && request.resource.data.payload.size() > 0 && request.resource.data.payload.size() <= 524288
            && request.resource.data.cost is int && request.resource.data.cost >= request.resource.data.payload.size()
            && request.resource.data.cost <= 8388608
            && request.resource.data.createdAt == request.time
            && increment(get(statePath(fid, did)).data, getAfter(statePath(fid, did)).data, oid, request.resource.data);
          allow delete: if retired() && getAfter(statePath(fid, did)).data.lastOpId == oid
            && decrement(get(statePath(fid, did)).data, getAfter(statePath(fid, did)).data, resource.data.payload);
        }
      }
    }
    match /{path=**}/invites/{id} {
      allow list: if signedIn() && resource.data.email == request.auth.token.email;
    }
  }
}
